# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ==================== 환경 변수 및 API 키 ====================
# IMPORTANT: API 키가 포함된 파일들 (절대 커밋 금지!)
.env
*.env.local
*.env.*.local

# .env.example은 템플릿이므로 커밋 허용 (실제 값 없음)
!.env.example

# ==================== Claude Code 관련 ====================
# Claude 설정 파일 (로컬 설정, API 키 포함 가능)
# NOTE: .claude/agents/는 프로젝트 가이드라인이므로 커밋 허용
.claude/settings.local.json
.claude/mcp.json
.claude/projects/

# 프로젝트 가이드라인 (선택적으로 제외)
CLAUDE.md

# ==================== 문서 폴더 ====================
# docs 폴더 전체 제외 (선택사항)
# 주석 해제하려면 아래 줄의 # 제거
# docs/

# 또는 특정 문서만 제외하려면:
# docs/prd.md
# docs/roadmap.md
# docs/features.md
# docs/personas.md

# ==================== 기타 민감한 파일 ====================
# Firebase 관련
google-services.json
GoogleService-Info.plist
firebase_options.dart

# 인증서 및 키 파일
*.keystore
*.jks
*.p12
*.key
*.pem

# 로컬 설정 파일
local.properties

# ==================== Supabase CLI 관련 ====================
# Supabase CLI 로컬 개발 환경 (Docker volumes 등)
.supabase/

# Supabase 로컬 환경 변수 (개인 access token 등)
supabase/.env

# NOTE: supabase/migrations/ 폴더는 커밋 필요 (제외하지 않음)

# ==================== E2E 테스트 관련 ====================
# 현재 테스트 스크린샷 (베이스라인만 Git 추적)
test/e2e/screenshots/current/
# QA 리포트 (생성된 결과, Git 무시)
test/e2e/reports/
# Flutter 웹 프로세스 PID
/tmp/flutter_web.pid

# ==================== Node.js 관련 (Playwright MCP) ====================
# Playwright MCP로 인한 npm 패키지
node_modules/
package-lock.json
package.json
